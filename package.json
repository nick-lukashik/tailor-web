{
    "name": "tailor-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=26",
        "pnpm": ">=12"
    },
    "scripts": {
        "dev": "next dev --port 3000",
        "build": "next build",
        "start": "node scripts/start-standalone.mjs",
        "lint": "biome check .",
        "format": "biome check --write .",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:real": "playwright test --project=real-api",
        "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "env:local": "node scripts/env-local.mjs",
        "api:types": "node scripts/api-types.mjs",
        "mock:api": "node e2e/mock-api/server.ts"
    },
    "dependencies": {
        "@tanstack/react-query": "5.105.0",
        "@tanstack/react-query-devtools": "5.105.0",
        "class-variance-authority": "0.7.1",
        "cn": "0.5.1",
        "lucide-react": "1.65.0",
        "next": "16.4.3",
        "next-intl": "4.14.9",
        "pino": "10.4.0",
        "radix-ui": "1.8.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "server-only": "0.0.1",
        "sonner": "2.0.8",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@biomejs/biome": "2.6.4",
        "@playwright/test": "1.64.1",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "babel-plugin-react-compiler": "1.0.0",
        "shadcn": "4.23.0",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "7.0.2",
        "vitest": "5.0.5"
    }
}
